# Set these environment variables in the shell before starting the server.
# The offline demonstration needs none of them.
RAG_API_KEY=
RAG_API_BASE=https://api.deepseek.com
# Use the actual API model identifier supplied by your provider.
RAG_MODEL=
# Optional neural retrieval/reranking. Models are downloaded by the library.
RAG_EMBEDDING_MODEL=
RAG_RERANKER_MODEL=
